---
const navItems = [
    {
        display: 'home',
        href: '/'
    },
    {
        display: 'about',
        href: '/about'
    },
    {
        display: 'gaming',
        href: '/gaming',
        children: [
            {
                display: 'flood escape 2',
                href: '/gaming/fe2',
            },
            {
                display: 'team fortress 2',
                href: '/gaming/tf2',
            },
        ]
    },
    {
        display: 'contact',
        href: '/contact'
    },
]

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
    if (href === '/') {
        return currentPath === '/';
    }
    return currentPath.startsWith(href);
};

const hasActiveChild = (children: any[] | undefined) => {
    if (!children) return false;
    return children.some(child => isActive(child.href));
};

const getNavClasses = (active: boolean) => [
    "relative font-bold transition-all duration-200 ease-out",
    "hover:scale-110",
    "after:absolute after:-bottom-1 after:h-0.5 after:transition-all after:duration-200",
    "after:w-0 hover:after:w-full",
    active
        ? "text-ctp-green hover:text-ctp-green after:bg-ctp-green after:w-1/3"
        : "hover:text-ctp-sapphire after:bg-ctp-sapphire",
].join(" ");
---
<header>
    <div class="fixed z-102 flex h-16 w-full items-center gap-2 bg-ctp-surface0 px-4 drop-shadow-[0px_2px_2px_#000]">
        <!--Site Mascot/Hero-->
        <div class="shrink-0">
            <a href="/"
               class={`${getNavClasses(false)} text-xl sm:text-2xl md:hover:text-[1.6rem] after:left-0`}>pinhead's
                site</a>
        </div>
        <!--Desktop Navigation-->
        <nav class="hidden md:flex items-center gap-2 ml-auto">
            {navItems.map((item) => (
                item.children ? (
                        <div class="relative group">
                            <a href={item.href}
                               class={`${getNavClasses(isActive(item.href) || hasActiveChild(item.children))} inline-flex items-center gap-1 after:left-1/2 after:-translate-x-1/2`}>
                                {item.display}
                                <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180"
                                     stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </a>
                            <div class="absolute left-0 mt-2 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-2 group-hover:translate-y-0">
                                <div class="bg-ctp-surface1 rounded-lg shadow-lg overflow-hidden border-2 border-ctp-surface2">
                                    {item.children.map((child) => (
                                            <a href={child.href}
                                               class={`block px-4 py-3 font-bold text-sm hover:bg-ctp-sapphire hover:text-[#4c4f69] transition-all duration-200 ease-out origin-left md:hover:scale-110 ${isActive(child.href) ? 'bg-ctp-green text-[#4c4f69]' : ''}`}>
                                                {child.display}
                                            </a>
                                    ))}
                                </div>
                            </div>
                        </div>
                ) : (
                        <a href={item.href}
                           class={`${getNavClasses(isActive(item.href))} after:left-1/2 after:-translate-x-1/2`}>
                            {item.display}
                        </a>
                )
            ))}
        </nav>
        <!--Mobile Navigation-->
        <button
                id="mobile-menu-button"
                class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg hover:bg-ctp-text transition-colors duration-200 ml-auto"
                aria-label="Toggle menu"
                aria-expanded="false">
            <svg id="hamburger-icon" class="w-6 h-6 transition-transform duration-200" stroke="currentColor"
                 viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg id="close-icon" class="w-6 h-6 hidden transition-transform duration-200" stroke="currentColor"
                 viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>
    <!--Mobile Menu-->
    <div
            id="mobile-menu"
            class="fixed z-101 top-16 left-0 w-full bg-ctp-surface0 max-h-0 opacity-0 overflow-hidden transition-all duration-300 ease-in-out drop-shadow-[0px_4px_4px_#000]">
        <nav class="flex flex-col px-4 py-2">
            {navItems.map((item) => (
                item.children ? (
                        <div class="mobile-dropdown">
                            <button class="mobile-dropdown-button w-full flex items-center justify-between py-3 font-bold border-b border-ctp-surface2 hover:text-ctp-sapphire transition-colors duration-200">
                            <span class={isActive(item.href) || hasActiveChild(item.children) ? 'text-ctp-green' : ''}>
                                {item.display}
                            </span>
                                <svg class="mobile-dropdown-arrow w-4 h-4 transition-transform duration-200"
                                     stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M19 9l-7 7-7-7"/>
                                </svg>
                            </button>
                            <div class="mobile-dropdown-content max-h-0 overflow-hidden transition-all duration-200 ease-in-out">
                                {item.children.map((child) => (
                                        <a
                                                href={child.href}
                                                class={`block pl-6 py-3 font-bold text-sm border-b border-ctp-surface2 hover:text-ctp-sapphire transition-colors duration-200 ${isActive(child.href) ? 'text-ctp-green' : ''}`}>
                                            {child.display}
                                        </a>
                                ))}
                            </div>
                        </div>
                ) : (
                        <a
                                href={item.href}
                                class={`block py-3 font-bold border-b border-ctp-surface2 hover:text-ctp-sapphire transition-colors duration-200 ${isActive(item.href) ? 'text-ctp-green' : ''}`}>
                            {item.display}
                        </a>
                )
            ))}
        </nav>
    </div>
    <!--Space Displacer-->
    <div class="h-16 w-full"></div>
</header>

<script>
    // Mobile menu toggle
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    menuButton?.addEventListener('click', () => {
        const isOpen = mobileMenu?.classList.contains('max-h-0');

        if (isOpen) {
            mobileMenu?.classList.remove('max-h-0', 'opacity-0');
            mobileMenu?.classList.add('max-h-96', 'opacity-100');
            hamburgerIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
            menuButton?.setAttribute('aria-expanded', 'true');
        } else {
            mobileMenu?.classList.add('max-h-0', 'opacity-0');
            mobileMenu?.classList.remove('max-h-96', 'opacity-100');
            hamburgerIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
            menuButton?.setAttribute('aria-expanded', 'false');
        }
    });

    // Mobile dropdown toggles
    const dropdownButtons = document.querySelectorAll('.mobile-dropdown-button');

    dropdownButtons.forEach(button => {
        button.addEventListener('click', () => {
            const dropdown = button.closest('.mobile-dropdown');
            const content = dropdown?.querySelector('.mobile-dropdown-content');
            const arrow = button.querySelector('.mobile-dropdown-arrow');
            const isOpen = content?.classList.contains('max-h-0');

            if (isOpen) {
                content?.classList.remove('max-h-0');
                content?.classList.add('max-h-40');
                arrow?.classList.add('rotate-180');
            } else {
                content?.classList.add('max-h-0');
                content?.classList.remove('max-h-40');
                arrow?.classList.remove('rotate-180');
            }
        });
    });

    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
        const header = document.querySelector('header');
        if (!header?.contains(e.target as Node)) {
            mobileMenu?.classList.add('max-h-0', 'opacity-0');
            mobileMenu?.classList.remove('max-h-96', 'opacity-100');
            hamburgerIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
            menuButton?.setAttribute('aria-expanded', 'false');
        }
    });
</script>