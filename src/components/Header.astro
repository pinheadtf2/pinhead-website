---
const navItems = [
    {
        display: 'home',
        href: '/'
    },
    {
        display: 'about',
        href: '/about'
    },
    {
        display: 'gaming',
        href: '/gaming',
        children: [
            {
                display: 'flood escape 2',
                href: '/fe2',
            }
        ]
    },
    {
        display: 'contact',
        href: '/contact'
    },
]
---

<div class="fixed top-0 left-0 w-full z-110 px-3 sm:px-4 md:px-6">
    <header class="bg-slate-200 shadow-md max-w-6xl mx-auto rounded-2xl drop-shadow-[0_0_8px_rgba(37,99,235,0.5)] sm:rounded-2xl mt-3 sm:mt-4 md:mt-5 relative">
        <div class="w-full mx-auto px-3 sm:px-4 lg:px-6">
            <div class="flex justify-between items-center h-14 sm:h-16">
                <!--Site Mascot-->
                <div class="flex-shrink-0">
                    <a href="/"
                       class="relative font-bold text-xl sm:text-2xl transition-all duration-200 ease-out hover:scale-105 md:hover:scale-110 md:hover:text-[1.6rem] hover:text-[#2196f3] after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-[#2196f3] after:transition-all after:duration-200 hover:after:w-full">pinhead's
                        site</a>
                </div>
                <!--Desktop Navigation-->
                <nav class="hidden md:flex space-x-4 lg:space-x-6">
                    {navItems.map((item) => (
                        <a href={item.href}
                       class="relative font-bold transition-all duration-200 ease-out hover:scale-105 hover:text-[#2196f3] after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-[#2196f3] after:transition-all after:duration-200 hover:after:w-full">{item.display}</a>
                    ))}
                </nav>
            </div>
        </div>
    </header>
</div>