---
const navItems = [
    {
        title: 'home',
        href: '/'
    },
    {
        title: 'about',
        href: '/about',
        dropdown: [
            {
                title: 'music',
                href: '/about/music'
            },
            {
                title: 'gaming',
                href: '/about/gaming',
                dropdown: [
                    {
                        title: 'flood escape 2',
                        href: '/about/gaming/fe2'
                    },
                ]
            },
        ]
    },
    {
        title: 'contact',
        href: '/contact'
    }
];

// Get current path for active state detection
const currentPath = Astro.url.pathname;
console.log(currentPath);

// Helper function to check if a link is active
function isActive(href: string) {
    if (href === '/') {
        return currentPath === '/';
    }
    return currentPath.startsWith(href);
}
---
<!--
To the poor soul inspecting this file expecting good code: turn back.
This is an amalgamation of inspiration from multiple sources, ai-assisted code, and keyboard-forehead smashing.
