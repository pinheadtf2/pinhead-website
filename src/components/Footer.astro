---
import {execSync} from 'child_process';

const currentYear: number = new Date().getFullYear();

function getCurrentCommitHash() {
    try {
        return execSync('git rev-parse --short HEAD').toString().trim();
    } catch (error) {
        console.error('Error getting commit hash:', error);
        return "commits N/A";
    }
}

function getMostRecentTag() {
    try {
        return execSync('git describe --tags --abbrev=0').toString().trim();
    } catch (error) {
        console.error('Error getting most recent tag:', error);
        return "tags N/A";
    }
}

const commitId = getCurrentCommitHash();
const commitTag = getMostRecentTag();
---
<footer class="fixed bottom-0 z-100 select-none rounded-tr-lg px-2 py-1 text-sm min-[1800px]:bg-transparent bg-slate-900">
    <span> © pinhead 2023-{currentYear}</span> &middot;
    <a href="https://github.com/pinheadtf2/pinhead-website/tree/version-5">{commitTag}</a> &middot;
    <a href=`https://github.com/pinheadtf2/pinhead-website/commit/${commitId}`>{commitId}</a>
</footer>